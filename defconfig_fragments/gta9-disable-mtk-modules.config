# ================================================================
# GTA9-specific defconfig fragment
# Disables broken/unused MediaTek kernel modules on 5.10
#
# Reason:
# - CONFIG_MTK_MKP: mkp_demo.c incompatible with kernel 5.10 API
#   Error: 'no member named security in struct cred'
# - CONFIG_MTK_PERF_*: perf_freq_tracker.c fails with implicit kzalloc
# 
# Impact:
# These modules are optional and not used by GTA9 device.
# Disabling them does not affect core functionality.
# ================================================================

# Disable Memory Kernel Protection (MKP) module
CONFIG_MTK_MKP=n

# Disable MediaTek Performance Common module
CONFIG_MTK_PERF_COMMON=n

# Disable MediaTek Performance Tracker module
CONFIG_MTK_PERF_TRACKER=n
